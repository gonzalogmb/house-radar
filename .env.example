# Copy to .env and adjust. All settings are optional; these are the defaults.
HR_DATA_DIR=data
HR_DELAY_SECONDS=5.0
HR_DELAY_JITTER=3.0
HR_MAX_RETRIES=4
HR_BACKOFF_BASE=4.0
HR_REQUEST_TIMEOUT=30.0
HR_MAX_PAGES_PER_RUN=5
HR_HEADLESS=true
# Hour of the daily run of every saved search; -1 disables the scheduler.
HR_DAILY_RUN_HOUR=7
HR_TIMEZONE=Europe/Madrid

# Official idealista API (request a key at https://www.idealista.com/labs/).
# Without these, the idealista portal reports its bot wall instead of returning data.
HR_IDEALISTA_API_KEY=
HR_IDEALISTA_API_SECRET=
